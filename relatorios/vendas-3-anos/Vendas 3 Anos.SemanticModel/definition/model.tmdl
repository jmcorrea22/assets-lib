model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Dimensões

	annotation PBI_QueryGroupOrder = 1

queryGroup Fatos

	annotation PBI_QueryGroupOrder = 2

queryGroup Base

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["BaseDeDados","dCalendario","dProdutos","dClientes","dLojas","fVendas","dVendedores","Medidas"]

annotation PBI_ProTooling = ["DevMode"]

ref table dCalendario
ref table dProdutos
ref table dClientes
ref table dLojas
ref table fVendas
ref table dVendedores
ref table Medidas
ref table pPeriodo
ref table pNumeroDeMeses

ref cultureInfo pt-BR

