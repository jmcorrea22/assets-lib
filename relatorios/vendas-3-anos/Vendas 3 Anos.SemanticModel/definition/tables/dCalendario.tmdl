		formatString: 0
		lineageTag: 744dc21c-604c-43b6-b4d9-3a5b64b2f208
		summarizeBy: none
		sourceColumn: Mês/Ano Ordem

		annotation SummarizationSetBy = Automatic

	partition dCalendario = m
		mode: import
		queryGroup: Dimensões
		source = ```
				let
				    // Data Inicial
				    DataMin = #date(2023, 3, 16),
				    // Data final da calendário:
				    Datamax = #date(2026, 3, 31),
				
				  // Quantidade de dias entre DataMin e Datamax
				  Qtde_Dias = Duration.TotalDays(Datamax - DataMin) + 1, 
				  
				  // Lista de Datas
				  Fonte = List.Dates(DataMin, Qtde_Dias, #duration(1, 0, 0, 0)), 
				  
				  //Tabela Calendário
				  Tabela = #table(
				    type table [
				      Data = date, 
				      Dia = Int8.Type, 
				      Semana = text, 
				      Semana Abrev = text, 
				      Semana do Ano = Int16.Type,
				      Semana do Mês = text,
				      Semana Ini = date, 
				      Semana Fim = date, 
				      Mês Nro = Int64.Type, 
				      Mês Nome = text,
				      Mês Atual = text,
				      Mês Ini = date, 
				      Mês Fim = date, 
				      Dias no Mês = Int64.Type, 
				      Trimestre = text, 
				      Trimestre Ini = date, 
				      Trimestre Fim = date, 
				      Ano = Int16.Type,
				      Ano Atual = text,
				      Ano Ini = date, 
				      Ano Fim = date, 
				      #"Mês/Ano" = text, 
				      #"Mês/Ano Ordem" = Int32.Type
				    ], 
				    List.Transform(
				      Fonte, 
				      each {
				        _,  																																		                    // Data: 01/12/2022, 02/12/2022, ...
				        Date.Day(_),  																																                    // Dia: 1, 2, 3, ...
				        Text.Repeat(Character.FromNumber(8203), 7 - Date.DayOfWeek(_)) & Text.BeforeDelimiter(Text.Proper(Date.ToText(_, "dddd", "pt-BR")), "-"),                       // Semana: Segunda, Terça, Quarta, ...
				        Text.Repeat(Character.FromNumber(8203), 7 - Date.DayOfWeek(_)) & Text.Proper(Date.ToText(_, "ddd", "pt-BR")),  								                    // Semana Abrev: Seg, Ter, Qua, ...
				        Date.WeekOfYear(_),                         								                                                                                    // Semana do Ano: 1, 2, 3, ...
				        Text.From(Date.WeekOfMonth(_)) & "ª Semana",  								                                                                                    // Semana do Mês: 1, 2, 3, ...
				        Date.StartOfWeek(_),                                                                                                                                            // Semana Ini: 02/01/2022, 09/01/2022, 16/01/2022, ... 
				        Date.EndOfWeek(_),                                                                                                                                              // Semana Fim: 08/01/2022, 05/01/2022, 22/01/2022, ... 
				        Date.Month(_),  								                                                                                                                // Mês Nro: 1, 2, 3, ...
				        Text.Repeat(Character.FromNumber(8203), 12 - Date.Month(_)) & Text.Proper(Date.ToText(_, "MMM", "pt-BR")),                                                      // Mês Nome: Jan, Fev, Mar, ...
				        if Date.IsInCurrentMonth(_) then "Mês Atual" else Text.Proper(Date.ToText(_, "MMMM/yy")),    // Mês Atual: Jan, Fev, Mês Atual, ...
				        Date.StartOfMonth(_),                                                                                                                                           // Mês Ini: 01/01/2022, 01/02/2022, 01/03/2022, ... 
				        Date.EndOfMonth(_),                                                                                                                                             // Mês Fim: 31/01/2022, 28/02/2022, 31/03/2022, ... 
				        Date.DaysInMonth(_),                                                                                                                                            // Dias no Mês: 31, 28, 30, ...
				        "T" & Text.From(Date.QuarterOfYear(_)),  																									                    // Trimestre: T1, T2, T3 e T4, ...
				        Date.StartOfQuarter(_),                                                                                                                                         // Trimestre Ini: 01/01/2022, 01/04/2022, 01/07/2022, ... 
				        Date.EndOfQuarter(_),                                                                                                                                           // Trimestre Fim: 31/03/2022, 30/06/2022, 30/09/2022, ... 
				        Date.Year(_),                                                             																						// Ano: 2021, 2022, 2023, 2024...
				        if Date.IsInCurrentYear(_) then "Ano Atual" else Text.From(Date.Year(_)),  																						// Ano Atual: 2021, 2022, 2023, Ano Atual...
				        Date.StartOfYear(_),                                                                                                                                            // Ano Ini: 01/01/2022, 01/01/2023, 01/01/2024, ... 
				        Date.EndOfYear(_),                                                                                                                                              // Ano Fim: 31/12/2022, 31/12/2023, 31/12/2024, ... 
				        Text.Proper(Date.ToText(_, "MMM/yy")), 																									                        // Mês/Ano: Jan/22, Fev/22, ...
				        12 * Date.Year(_) + Date.Month(_) - 1  																									                        // Mês/Ano Ordem: 24287, 24286, ...
				      }
				    )
				  )
				in
				    Tabela
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

